# Environment configuration for webhook-based Chrome browser controller
# Copy this file to .env and modify the values as needed

# Webhook server configuration
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=5000
FLASK_DEBUG=False

# Security - IMPORTANT: Change this in production!
WEBHOOK_SECRET_TOKEN=your-secure-secret-token-here

# Chrome WebDriver configuration
# CHROME_DRIVER_PATH=/path/to/chromedriver  # Optional, uses PATH if not set
CHROME_HEADLESS=False
CHROME_WINDOW_SIZE=1920,1080

# Browser timeouts (in seconds)
PAGE_LOAD_TIMEOUT=30
IMPLICIT_WAIT_TIMEOUT=10

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=webhook_browser.log